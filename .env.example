# Скопируйте файл в .env и подставьте свои значения.
# .env добавлен в .gitignore и НИКОГДА не попадает в исходный код.

# Токен бота от @BotFather
TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Yandex AI Studio (Foundation Models). Если не заполнить —
# бот полностью работает офлайн на ML-модели, FAQ и датасете диалогов.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite/latest
# true — модель дополняет карточки товаров художественным описанием.
# Цифры, цены, наличие, доставка и гарантия при этом запрещены и отсекаются фильтром.
YANDEX_DESCRIPTIONS=false

# Путь к распакованной модели Vosk (vosk-model-small-ru-0.22, ~50 МБ)
VOSK_MODEL_PATH=models/vosk-model-small-ru-0.22

# Прокси (опционально). Формат: http://user:pass@host:port или socks5://host:port
TELEGRAM_PROXY=
YANDEX_PROXY=

# Прочее
DIALOGUES_PATH=data/dialogues.txt
DB_PATH=dialog_history.db
AD_EVERY_N=7
